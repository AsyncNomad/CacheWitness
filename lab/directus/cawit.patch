-import { redisConfigAvailable } from './redis/index.js';
+import { redisConfigAvailable, useRedis } from './redis/index.js';
+// CacheWitness sync hook (test only): a no-op unless CAWIT_SYNC_URL is set.
+import * as cawit from 'cawit-hook';
 import { compress, decompress } from './utils/compress.js';
 import { freezeSchema, unfreezeSchema } from './utils/freeze-schema.js';
 import { getConfigFromEnv } from './utils/get-config-from-env.js';
@@ -61,6 +63,28 @@ export function getCache(): {
 		validateEnv(['CACHE_NAMESPACE', 'CACHE_TTL', 'CACHE_STORE']);
 		cache = getKeyvInstance(env['CACHE_STORE'] as Store, getMilliseconds(env['CACHE_TTL']));
 		cache.on('error', (err) => logger.warn(err, `[cache] ${err}`));
+
+		// CacheWitness lab patch (test only): candidate fixes, chosen with CW_FIX.
+		// Stale-set race: 'ddel' purges again CW_DDEL_MS later (delayed double
+		// delete); 'gen' bumps a generation before purging, and a refill that
+		// started under an older generation drops its write (respond.ts).
+		// Failed invalidation: 'retry' tries the purge once more if it fails.
+		const cwPurge = cache.clear.bind(cache);
+		const cwInvalidate = async () => {
+			await cawit.syncPoint('invalidate:before', 'data');
+			if (process.env['CW_FIX'] === 'gen') await useRedis().incr('cawit-lab:gen');
+			await cwPurge();
+		};
+		cache.clear = async () => {
+			try {
+				await cwInvalidate();
+			} catch (err) {
+				if (process.env['CW_FIX'] !== 'retry') throw err;
+				await cwInvalidate();
+			}
+			const ms = Number(process.env['CW_DDEL_MS'] || 500);
+			if (process.env['CW_FIX'] === 'ddel') setTimeout(() => void cwPurge().catch(() => {}), ms).unref();
+		};
 	}
 
 	if (systemCache === null) {
