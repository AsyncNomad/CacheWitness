+// CacheWitness lab patch: deterministic sync point (test only). When
+// CW_SYNC=1, the first workspace refill after the runner sets cw:sync:arm
+// stops right after its DB read, signals cw:sync:reached, and waits for
+// cw:sync:release, so a runner can commit and invalidate in between.
+let cwSyncClient: ReturnType<typeof createClient> | undefined;
+const cwSyncPoint = async (cacheKeyName: string) => {
+  if (process.env.CW_SYNC !== '1' || cacheKeyName !== 'workspaceEntity') return;
+  if (!cwSyncClient) {
+    cwSyncClient = createClient({ url: process.env.REDIS_URL || 'redis://localhost:6379' });
+    await cwSyncClient.connect();
+  }
+  const armed = await cwSyncClient.getDel('cw:sync:arm');
+  if (!armed) return;
+  await cwSyncClient.rPush('cw:sync:reached', '1');
+  await cwSyncClient.blPop('cw:sync:release', 30);
+};
+
+// CacheWitness lab patch: candidate fixes for the stale-set race (test only),
+// chosen with CW_FIX. 'vcas' writes only if the cached copy is not newer
+// (compares updatedAt); 'lease' takes a lease before the DB read, invalidation
+// deletes it, and the refill writes only if its lease is still there.
+const CW_TTL_MS = 604800000;
+const CW_VCAS_SCRIPT = `
+local cur = redis.call('GET', KEYS[2])
+if cur then
+  local ok, obj = pcall(cjson.decode, cur)
+  if ok and type(obj) == 'table' and obj.updatedAt and obj.updatedAt >= ARGV[3] then return 0 end
+end
+redis.call('SET', KEYS[1], ARGV[1], 'PX', ARGV[4])
+redis.call('SET', KEYS[2], ARGV[2], 'PX', ARGV[4])
+return 1`;
+const CW_LEASE_SCRIPT = `
+if redis.call('GET', KEYS[1]) == ARGV[1] then
+  redis.call('SET', KEYS[2], ARGV[2], 'PX', ARGV[4])
+  redis.call('SET', KEYS[3], ARGV[3], 'PX', ARGV[4])
+  redis.call('DEL', KEYS[1])
+  return 1
+end
+return 0`;
+
+// CacheWitness lab patch: counts applied refill delays for the manipulation check.
+const cwRefillDelayed = { count: 0 };
+if (Number(process.env.CW_REFILL_DELAY_MS || 0) > 0) {
+  setInterval(() => {
+    // oxlint-disable-next-line no-console
+    console.log(`cw-refill-delay ms=${process.env.CW_REFILL_DELAY_MS} applied=${cwRefillDelayed.count}`);
+  }, 5000).unref();
+}
